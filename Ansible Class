Playbook:

---
- name: To understand playbook
  hosts: FE
  become: yes
  tasks:
    - name: To install httpd and git
      dnf:
        name: httpd
        state: present
        ignore_errors: yes
        name: git
        state: present

    - name: To clone repo to destination
      git:
        repo: https://github.com/riyanuddin17
        dest: /var/www/html
      notify: To restart the service

  handlers:
    - name: To restart the service
      service:
        name: httpd
        state: restarted
---


